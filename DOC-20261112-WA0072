function netErr(t){setSt(t,1)}
function initPersonal(){
  return new Promise(res=>{
    if(typeof Peer==='undefined'){netErr('Não consegui carregar a rede. Verifique a internet.');res(false);return}
    const done=v=>{if(!done.d){done.d=1;res(v)}};
    personal=new Peer('lt-u-'+me.id);
    personal.on('open',()=>done(true));
    personal.on('error',e=>{
      if(e.type==='peer-unavailable'){const m=/lt-[\w-]+/.exec(e.message||'');if(m&&pending[m[0]])pending[m[0]](null)}
      else if(e.type==='unavailable-id'){netErr('Seu ID já está aberto em outra aba ou aparelho.');done(false)}
      else if(!done.d){netErr('Erro de rede: '+e.type);done(false)}
    });
    personal.on('connection',c=>{c.on('data',d=>{if(d&&d.t==='who'){try{c.send({t:'room',room:currentRoom,name:myName(),info:roomInfo})}catch(e){}}})});
    setTimeout(()=>done(!!personal.open),9000);
  });
}
function dial(peerId,ms){
  return new Promise(res=>{
    let fin=false;const done=v=>{if(fin)return;fin=true;delete pending[peerId];clearTimeout(tm);res(v)};
    pending[peerId]=()=>done(null);
    const c=personal.connect(peerId,{reliable:false,serialization:'json'});
    c.on('open',()=>done(c));c.on('error',()=>done(null));
    const tm=setTimeout(()=>{try{c.close()}catch(e){}done(null)},ms||5000);
  });
}
function waitMsg(c,types,ms){
  return new Promise(res=>{
