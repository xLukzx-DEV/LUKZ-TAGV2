    if(this.mode==='f'){for(const f of fz){if(this.role(f.id)!==2)continue;for(const r of rn){if(this.role(r.id)!==0)continue;if(this.touch(r,f)){this.roles[f.id]=0;this.ev.push(this.nm(r.id)+' descongelou '+this.nm(f.id));break}}}}
    const left=pl.filter(p=>this.role(p.id)===0).length;
    if(left===0){this.phase='over';this.tm=6;this.win='Pegadores venceram'}
    else if(this.tm<=0){this.phase='over';this.tm=6;this.win='Fugitivos venceram'}
  }
}
