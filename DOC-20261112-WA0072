if(typeof THREE==='undefined'){showErr('Não carregou o three.js. Verifique a internet e recarregue.');return}

/*CORE_START*/
const EYE=1.6,HGT=1.75,STEP=.46,RAD=.32,MAXP=8;
const MODES=[
 {id:'c',name:'Clássico',desc:'Um pegador por vez. Quem é tocado vira o pegador. Vence quem passar menos tempo pegando.'},
 {id:'i',name:'Infecção',desc:'Quem é tocado vira pegador. Os fugitivos precisam sobreviver até o tempo acabar.'},
 {id:'f',name:'Congela',desc:'Pegadores congelam os fugitivos. Um amigo livre toca em você para descongelar.'}];
const MAPDEF=[
 {id:0,name:'Bosque',desc:'Árvores gigantes com escadas em espiral, pontes de corda, lagoa, cogumelos trampolim e casas na árvore.',A:30,grav:11,fric:2.4,rough:.22,water:-.5,wet:1,sky:[0x4f9cf0,0xcfe9ff],fog:0xcfe9ff,fogN:34,fogF:105,tiles:[0,1,2],ground:[0x5e9c46,0x8a6a45,0x7d8088],wall:0x56707a,amb:.6,sun:[.5,.75,.4],cloud:14,wcol:0x3c8fbf,wop:.62},
 {id:1,name:'Cânion',desc:'Rio no fundo do vale, mesas altas, arco de pedra, pontes e gêiseres que lançam você para o alto.',A:32,grav:11,fric:2.4,rough:.3,water:-.7,wet:1,sky:[0xe38a45,0xffdcae],fog:0xffdcae,fogN:36,fogF:110,tiles:[7,1,2],ground:[0xd99a5c,0xb7773f,0x9c5a35],wall:0xb5683a,amb:.6,sun:[-.5,.7,.45],cloud:5,wcol:0x4fb0b8,wop:.7},
 {id:2,name:'Gelo',desc:'Montanhas geladas onde você escorrega, lago congelado, farol de gelo, arcos e trampolins de neve.',A:30,grav:11,fric:.55,rough:.2,water:-1.2,wet:0,sky:[0x6aa6e0,0xeaf5ff],fog:0xeaf5ff,fogN:32,fogF:100,tiles:[6,14,2],ground:[0xeef8ff,0xbfe3f5,0x9fb4c4],wall:0x8fb0c8,amb:.64,sun:[.4,.8,-.4],cloud:18,wcol:0xbfeaff,wop:.9},
 {id:3,name:'Neon',desc:'Cidade de noite com gravidade baixa: prédios, pontes entre os telhados, metrô e trampolins nas ruas.',A:32,grav:7.5,fric:2.4,rough:0,water:null,wet:0,sky:[0x06041a,0x3b1a70],fog:0x1d1040,fogN:32,fogF:100,tiles:[9,9,2],ground:[0x241f4a,0x2e2860,0x3a3170],wall:0x2a1f55,amb:.66,sun:[.3,.7,.5],cloud:0,stars:1,wcol:0x2be8ff,wop:.5}];
function mulberry(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function buildMap(id){
  const def=MAPDEF[id],A=def.A,R=mulberry(777+id*131);
  const items=[],solids=[],pads=[],paths=[],casters=[],flats=[],hills=[],bowls=[];
  const rr=(a,b)=>a+R()*(b-a),pick=a=>a[Math.floor(R()*a.length)];
  const H=(x,z)=>{
    let h=def.rough*(Math.sin(x*.21+1.7)*Math.cos(z*.17+.3)+.5*Math.sin(x*.47+z*.39+2));
    for(let i=0;i<hills.length;i++){const q=hills[i];h+=q[3]*Math.exp(-((x-q[0])*(x-q[0])+(z-q[1])*(z-q[1]))/(2*q[2]*q[2]))}
    for(let i=0;i<bowls.length;i++){const q=bowls[i];h-=q[3]*Math.exp(-((x-q[0])*(x-q[0])+(z-q[1])*(z-q[1]))/(2*q[2]*q[2]))}
    const e=Math.max(0,(Math.max(Math.abs(x),Math.abs(z))-(A-6))/6);h+=e*e*3.5;
    let m=1;for(let i=0;i<flats.length;i++){const f=flats[i],d=Math.hypot(x-f[0],z-f[1]);if(d<f[3]){const t=d<=f[2]?0:(d-f[2])/(f[3]-f[2]),s=t*t*(3-2*t);if(s<m)m=s}}
    return h*m;
  };
  const box=(x,z,w,d,y0,y1,c,t,ns)=>{items.push({k:'b',x,z,w,d,y0,y1,c,t:t==null?15:t});if(!ns)solids.push({x,z,hx:w/2,hz:d/2,y0,y1})};
  const col=(x,z,w,d,y0,y1)=>solids.push({x,z,hx:w/2,hz:d/2,y0,y1});
  const cyl=(x,z,y0,h,rt,rb,c,t,seg)=>items.push({k:'y',x,z,y0,y1:y0+h,h,rt,rb,c,t:t==null?15:t,seg:seg||7});
  const ball=(x,y,z,r,c,t,det)=>items.push({k:'s',x,y,z,r,c,t:t==null?15:t,det:det||0,y0:y-r});
  const flat=(x,z,r)=>flats.push([x,z,r,r+4]);
  const free=(x,z,m)=>!solids.some(s=>Math.abs(x-s.x)<s.hx+m&&Math.abs(z-s.z)<s.hz+m)&&!flats.some(f=>Math.hypot(x-f[0],z-f[1])<f[2]);
  const padFor=h=>Math.sqrt(2*def.grav*(h+1.3));
  const pad=(x,z,y,r,b)=>{pads.push({x,z,y,r,b});cyl(x,z,y-.05,.3,r,r,0xffd21f,13,10)};
  const stairs=(x,z,dx,dz,n,w,dep,rise,c,t)=>{const pts=[];for(let i=0;i<n;i++){const cx=x+dx*dep*(i+.5),cz=z+dz*dep*(i+.5);box(cx,cz,dx?dep:w,dz?dep:w,0,(i+1)*rise,c,t);pts.push([cx,cz]);if(i%3===0)flat(cx,cz,w/2+1.5)}paths.push({pts,top:n*rise})};
  const spiral=(cx,cz,half,n,c,t)=>{
    const wid=2.2,d=half+wid/2,L=Math.ceil(2*d/.9),dep=2*d/L,pts=[];
    for(let k=0;k<n;k++){
      const side=Math.floor(k/L)%4,i=k%L,s=-d-wid/2+dep*(i+.5),top=(k+1)*.4;let x,z,w,dd;
      if(side===0){x=cx+s;z=cz-d;w=dep;dd=wid}else if(side===1){x=cx+d;z=cz+s;w=wid;dd=dep}else if(side===2){x=cx-s;z=cz+d;w=dep;dd=wid}else{x=cx-d;z=cz-s;w=wid;dd=dep}
      box(x,z,w,dd,Math.max(0,top-.5),top,c,t);pts.push([x,z]);
    }
    const last=pts[pts.length-1],din=half+wid;
    const ox=last[0]-cx,oz=last[1]-cz,m=Math.max(Math.abs(ox),Math.abs(oz))||1;
    pts.push([cx+ox/m*(din+1.5),cz+oz/m*(din+1.5)]);
    return{top:n*.4,din,pts};
  };
  const deck=(cx,cz,din,dout,top,c,t)=>{const y0=top-.4,mid=(din+dout)/2;
    box(cx,cz-mid,2*dout,dout-din,y0,top,c,t);box(cx,cz+mid,2*dout,dout-din,y0,top,c,t);box(cx-mid,cz,dout-din,2*din,y0,top,c,t);box(cx+mid,cz,dout-din,2*din,y0,top,c,t);
    for(let k=-dout+1;k<=dout;k+=3){[[k,-dout+.15],[k,dout-.15],[-dout+.15,k],[dout-.15,k]].forEach(q=>box(cx+q[0],cz+q[1],.2,.2,top,top+1,0x6e4a2e,3,1))}
    box(cx,cz-dout+.15,2*dout,.12,top+.9,top+1,0x8a5a32,3,1);box(cx,cz+dout-.15,2*dout,.12,top+.9,top+1,0x8a5a32,3,1);box(cx-dout+.15,cz,.12,2*dout,top+.9,top+1,0x8a5a32,3,1);box(cx+dout-.15,cz,.12,2*dout,top+.9,top+1,0x8a5a32,3,1);
  };
  const bridge=(x0,z0,x1,z1,ya,yb,w,c,t)=>{
    const ax=Math.abs(x1-x0)>=Math.abs(z1-z0),len=ax?Math.abs(x1-x0):Math.abs(z1-z0),dir=ax?Math.sign(x1-x0):Math.sign(z1-z0);
    const n=Math.ceil(Math.abs(yb-ya)/.4-1e-6),sd=1,f1=Math.max(.5,(len-n*sd)/2);
    const seg=(p,l,top)=>{const m=p+l/2,x=ax?x0+dir*m:x0,z=ax?z0:z0+dir*m;box(x,z,ax?l:w,ax?w:l,top-.3,top,c,t)};
