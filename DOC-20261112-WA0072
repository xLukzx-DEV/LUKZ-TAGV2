        const p=hostPlayers.get(pid);p.h=[d.p[0],d.p[1],d.p[2]];p.l=[d.p[3],d.p[4],d.p[5]];p.r=[d.p[6],d.p[7],d.p[8]];p.yaw=+d.y||0;p.pitch=+d.pt||0;p.last=performance.now();
