async function checkAll(){
  if(checking||inGame||!personal||!personal.open||curScr!=='online')return;
  checking=true;try{for(const f of friends){await checkFriend(f);renderF()}}finally{checking=false}
}
function refreshOnline(){renderF();checkAll()}
$('fadd').onclick=()=>{
  const id=$('fid').value.trim().toUpperCase();
  if(id.length<4){setSt('Digite o ID do amigo.',1);return}
  if(id===me.id){setSt('Esse é o seu próprio ID.',1);return}
  if(!friends.find(f=>f.id===id)){friends.push({id,name:'Amigo'});saveF()}
  $('fid').value='';renderF();setSt('Amigo adicionado.');
  checkFriend(friends.find(z=>z.id===id)).then(renderF);
};
setInterval(checkAll,12000);

/* ---------- jogo ---------- */
function beginCountdown(){
  inGame=false;const ov=$('ov');ov.style.display='flex';let n=6;
  (async()=>{
    try{const d=document.documentElement;if(d.requestFullscreen)await d.requestFullscreen({navigationUI:'hide'})}catch(e){}
    try{await screen.orientation.lock('landscape')}catch(e){}
    try{if(navigator.wakeLock)navigator.wakeLock.request('screen').catch(()=>{})}catch(e){}
  })();
  const tick=()=>{
    if(n>0){ov.innerHTML=(cfg.vr?'Coloque o celular<br>no VR box':'Prepare-se')+'<br><span style="font-size:64px">'+n+'</span>'+(motionOK()?'':'<br><span style="font-size:16px;color:#ffb3bb">Giroscópio sem dados. Arraste o dedo na tela para olhar.</span>');n--;sfx('tick');setTimeout(tick,1000)}
    else{ov.style.display='none';startGame()}
  };tick();
}
function startGame(){
  recenter();previewOn=false;handMs=62;setSt('');
  document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));
  $('c').style.display='block';$('x').style.display='block';
  rsMax=cfg.qual==='auto'?1:parseFloat(cfg.qual);rs=cfg.qual==='auto'?.7:rsMax;
  const sp=pickSpawn(curMap,Math.random);S.x=sp[0];S.z=sp[1];S.y=curMap.h(S.x,S.z);S.vx=S.vz=S.vy=0;S.on=true;
  inGame=true;applyView();
  last=performance.now();netAcc=0;hudAcc=0;fpsAcc=0;fpsN=0;
  requestAnimationFrame(loop);
}
$('x').onclick=()=>leaveToMenu();
function leaveToMenu(){location.reload()}

let touchWalk=false,tapT=0,wantJump=false,tx0=0,ty0=0,touchMoved=false;const keys={};
$('c').addEventListener('touchstart',e=>{touchWalk=true;touchMoved=false;const t=e.touches[0];tx0=t.clientX;ty0=t.clientY;const n=performance.now();if(n-tapT<320)wantJump=true;tapT=n;e.preventDefault()},{passive:false});
$('c').addEventListener('touchmove',e=>{if(motionOK())return;const t=e.touches[0];dragYaw-=(t.clientX-tx0)*.006;dragPitch=Math.max(-1.4,Math.min(1.4,dragPitch-(t.clientY-ty0)*.006));tx0=t.clientX;ty0=t.clientY;touchMoved=true;e.preventDefault()},{passive:false});
$('c').addEventListener('touchend',()=>{touchWalk=false});
let dragging=false,lx=0,ly=0;
$('c').addEventListener('mousedown',e=>{dragging=true;lx=e.clientX;ly=e.clientY});
addEventListener('mouseup',()=>dragging=false);
addEventListener('mousemove',e=>{if(!dragging||motionOK())return;dragYaw-=(e.clientX-lx)*.005;dragPitch=Math.max(-1.4,Math.min(1.4,dragPitch-(e.clientY-ly)*.005));lx=e.clientX;ly=e.clientY});
addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;if(e.key===' ')wantJump=true});addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);

let last=0,netAcc=0,hudAcc=0,fpsAcc=0,fpsN=0,jumpCd=0,fpsLow=0,errShown=false;
const tmpF=new THREE.Vector3(),tmpH=new THREE.Vector3(),dirV=new THREE.Vector3(0,0,-1);
function loop(t){
  if(!inGame)return;
  requestAnimationFrame(loop);
  const dt=Math.min(.1,Math.max(.001,(t-last)/1000));last=t;
  try{update(dt);renderFrame()}catch(err){if(!errShown){errShown=true;showErr('Erro no jogo: '+(err&&err.message||err)+(err&&err.stack?'\n'+String(err.stack).split('\n').slice(0,3).join('\n'):''))}}
  fpsAcc+=dt;fpsN++;
  if(fpsAcc>=1){const fps=fpsN/fpsAcc;fpsAcc=0;fpsN=0;adapt(fps)}
}
function placeCams(){
  camL.quaternion.copy(headQ);camR.quaternion.copy(headQ);
  if(!cfg.vr){camL.position.copy(selfV.head);return}
  _v2.set(1,0,0).applyQuaternion(headQ);const h=cfg.ipd/2;
  camL.position.copy(selfV.head).addScaledVector(_v2,-h);camR.position.copy(selfV.head).addScaledVector(_v2,h);
}
function adapt(fps){
  handMs=fps<30?110:62;
  if(cfg.qual!=='auto')return;
  let nr=rs;
  if(fps<42){nr=Math.max(.42,rs-.08);fpsLow=0}else if(fps>57){fpsLow++;if(fpsLow>=3&&rs<rsMax){nr=Math.min(rsMax,rs+.04);fpsLow=0}}
  if(Math.abs(nr-rs)>.01){rs=nr;applyView()}
}
function update(dt){
  updateHeadQ();const now=performance.now()/1000;
  tmpF.set(0,0,-1).applyQuaternion(headQ);
  selfV.yaw=Math.atan2(-tmpF.x,-tmpF.z);selfV.pitch=Math.asin(Math.max(-1,Math.min(1,tmpF.y)));
  tmpF.y=0;if(tmpF.lengthSq()>.01){tmpF.normalize();dirV.copy(tmpF)}
  const rest=[[-.28,-.45,-.35],[.28,-.45,-.35]];let drive=0;
  for(let i=0;i<2;i++){const s=H[i];
    if(now-s.seen>.35){const k=Math.min(1,3*dt);s.v*=Math.exp(-9*dt);s.vy*=Math.exp(-9*dt);s.p.x+=(rest[i][0]-s.p.x)*k;s.p.y+=(rest[i][1]-s.p.y)*k;s.p.z+=(rest[i][2]-s.p.z)*k}
    drive+=Math.max(0,s.v-.4)}
  const frozen=myRole===2;
  if(!frozen){
    const acc=drive*cfg.sens*9+(((touchWalk&&!touchMoved)||keys['w']||keys['arrowup'])?6:0);
    S.vx+=dirV.x*acc*dt;S.vz+=dirV.z*acc*dt;
    const sp=Math.hypot(S.vx,S.vz);if(sp>5.6){S.vx*=5.6/sp;S.vz*=5.6/sp}
  }else{S.vx=S.vz=0}
  jumpCd-=dt;
  const handJump=H[0].vy>1.8&&H[1].vy>1.8&&now-H[0].seen<.3&&now-H[1].seen<.3;
  if((handJump||wantJump)&&S.on&&jumpCd<=0&&!frozen){S.vy=Math.sqrt(2*curMap.def.grav*1.25);S.on=false;jumpCd=.55;sfx('jump')}
  wantJump=false;
  S.pad=0;physStep(S,curMap,dt,curMap.def.fric,curMap.def.grav);
  if(S.pad){sfx('pad');jumpCd=.3}
  selfV.head.set(S.x,S.y+EYE,S.z);
  tmpH.copy(H[0].p).applyQuaternion(headQ).add(selfV.head);selfV.hl.copy(tmpH);
  tmpH.copy(H[1].p).applyQuaternion(headQ).add(selfV.head);selfV.hr.copy(tmpH);
  pose(selfV.av,selfV.head.x,selfV.head.y,selfV.head.z,selfV.yaw,selfV.pitch,[selfV.hl.x,selfV.hl.y,selfV.hl.z],[selfV.hr.x,selfV.hr.y,selfV.hr.z]);
  selfV.av.mark.visible=false;
  skyG.position.copy(selfV.head);if(cloudMesh)cloudMesh.rotation.y+=dt*.004;
  placeCams();
  netAcc+=dt;
  if(netAcc>=.066){if(role==='host')hostTick(netAcc);else{clientSend();if(performance.now()-lastW>7000)leaveToMenu()}netAcc=0}
  const k=Math.min(1,dt*13);
  for(const r of remotes.values()){
    r.p.lerp(r.tp,k);r.l.lerp(r.tl,k);r.r.lerp(r.tr,k);r.yaw=angLerp(r.yaw,r.tyaw,k);r.pitch+=(r.tpitch-r.pitch)*k;
    pose(r.av,r.p.x,r.p.y,r.p.z,r.yaw,r.pitch,[r.l.x,r.l.y,r.l.z],[r.r.x,r.r.y,r.r.z]);
  }
  flash=Math.max(0,flash-dt*1.4);
  hudAcc+=dt;if(hudAcc>.2){hudAcc=0;drawHud()}
}
function rrect(x,a,b,w,h,r){x.beginPath();x.moveTo(a+r,b);x.arcTo(a+w,b,a+w,b+h,r);x.arcTo(a+w,b+h,a,b+h,r);x.arcTo(a,b+h,a,b,r);x.arcTo(a,b,a+w,b,r);x.closePath()}
function drawHud(){
  const x=hudCx,Wd=640,Hd=192;x.clearRect(0,0,Wd,Hd);
  x.fillStyle=flash>0?'rgba(255,50,60,.88)':'rgba(8,10,24,.66)';rrect(x,6,6,Wd-12,Hd-12,26);x.fill();
  x.strokeStyle=myRole===1?'#ff5060':myRole===2?'#9fe6ff':'#b6ff3c';x.lineWidth=4;x.stroke();
  x.textAlign='center';x.textBaseline='middle';
  const total=remotes.size+1,ids=Object.keys(W.roles);let l1='',c1='#eef1ff',l2='';
  const cnt=r=>ids.filter(i=>W.roles[i]===r).length,nameOf=id=>id===me.id?myName():(remotes.get(id)?remotes.get(id).av.name:'?');
  const mm=s=>Math.floor(s/60)+':'+('0'+(s%60)).slice(-2);
  if(W.phase==='wait'){l1='AGUARDANDO JOGADORES';c1='#ffd21f';l2=total+'/2 · '+roomLabel}
  else if(W.phase==='ready'){l1='PREPARAR '+W.tm;c1='#ffd21f';l2=MODES.find(m=>m.id===W.mode).name+' · '+roomLabel}
  else if(W.phase==='over'){l1=W.win.toUpperCase();c1='#b6ff3c';l2='Nova rodada em '+W.tm+'s'}
  else if(W.mode==='c'){const tg=ids.find(i=>W.roles[i]===1);if(myRole===1){l1='VOCÊ PEGA!';c1='#ff6a78'}else{l1='FUJA DE '+nameOf(tg).toUpperCase();c1='#b6ff3c'}l2='pegador: '+Math.round((W.tt&&W.tt[me.id])||0)+'s · '+total+' jogadores'}
  else{
    if(myRole===1){l1='VOCÊ PEGA!';c1='#ff6a78'}else if(myRole===2){l1='CONGELADO!';c1='#9fe6ff'}else{l1='FUJA!';c1='#b6ff3c'}
    l2=mm(W.tm)+' · fugindo '+cnt(0)+' · pegadores '+cnt(1)+(W.mode==='f'?' · congelados '+cnt(2):'');
  }
  x.fillStyle=c1;x.font='800 54px system-ui,sans-serif';x.fillText(l1,Wd/2,62,Wd-60);
  x.fillStyle='#c9d2f2';x.font='600 29px system-ui,sans-serif';x.fillText(l2,Wd/2,112,Wd-60);
  const nowT=performance.now(),ev=evs.filter(e=>nowT-e.t<5000).slice(-1)[0];
  x.fillStyle=motionOK()?'#8e9ac4':'#ffb3bb';x.font='600 24px system-ui,sans-serif';
  x.fillText(ev?ev.s:(motionOK()?'mãos: '+handCount+' · '+Math.round(rs*100)+'% res.':'sem giroscópio: arraste na tela para olhar'),Wd/2,156,Wd-60);
  hudTex.needsUpdate=true;
}

/* ---------- partida ---------- */
buildHome();buildSettings();buildCustom();renderF();gyroUI();
initPersonal().then(ok=>{if(ok)checkAll()});
window.__luk={cfg,me,get S(){return S},cam(){return camL?{l:[camL.position.x,camL.position.y,camL.position.z],r:[camR.position.x,camR.position.y,camR.position.z],q:[camL.quaternion.x,camL.quaternion.y,camL.quaternion.z,camL.quaternion.w]}:null},buildMap,physStep};
})();
</script>
