    if(myRole===1&&prevRole!==1){flash=1;sfx('tag');try{navigator.vibrate&&navigator.vibrate(250)}catch(e){}}
    else if(myRole===2){flash=1;sfx('freeze');try{navigator.vibrate&&navigator.vibrate(120)}catch(e){}}
