    const ids=pl.map(p=>p.id);for(let i=ids.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ids[i],ids[j]]=[ids[j],ids[i]]}
    this.roles={};ids.forEach((id,i)=>{this.roles[id]=i<k?1:0});
    this.phase='play';this.tm=this.mode==='i'?120:150;this.win='';
  }
  classic(dt,pl){
    this.phase='play';
    let tg=pl.find(p=>this.role(p.id)===1);
    if(!tg){const p=pl[Math.floor(Math.random()*pl.length)];this.roles={};this.roles[p.id]=1;this.cd=3;tg=p}
    for(const p of pl)if(p!==tg&&this.role(p.id)===1)this.roles[p.id]=0;
    this.cd=Math.max(0,this.cd-dt);this.tt[tg.id]=(this.tt[tg.id]||0)+dt;
