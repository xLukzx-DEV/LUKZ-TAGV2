    if(this.phase==='over'){this.tm-=dt;if(this.tm<=0){this.phase='ready';this.tm=5;this.roles={};this.win=''}return}
    this.tm-=dt;
    if(!pl.some(p=>this.role(p.id)===1)){const rn=pl.filter(p=>this.role(p.id)===0);if(rn.length)this.roles[rn[Math.floor(Math.random()*rn.length)].id]=1}
    const tg=pl.filter(p=>this.role(p.id)===1),fz=pl.filter(p=>this.role(p.id)===2),rn=pl.filter(p=>this.role(p.id)===0);
    for(const t of tg)for(const r of rn){
      if(this.role(r.id)!==0)continue;
