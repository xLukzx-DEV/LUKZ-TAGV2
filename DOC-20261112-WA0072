<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#0b0e1c">
<title>LUKZ TAG</title>
<style>
:root{--bg:#0b0e1c;--p1:#141a33;--p2:#1b2344;--line:#2c3763;--fg:#eef1ff;--mut:#8e9ac4;--acc:#b6ff3c;--acc2:#ff7a1a;--bad:#ff4d5e;--ok:#3cffa0}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:15px/1.35 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;overscroll-behavior:none;-webkit-user-select:none;user-select:none;overflow:hidden}
#c{position:fixed;inset:0;width:100%;height:100%;display:none;touch-action:none;background:#000}
.scr{position:fixed;inset:0;display:none;overflow:auto;padding:max(14px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(14px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));background:radial-gradient(900px 500px at 85% -10%,#2a2f66 0%,transparent 60%),radial-gradient(700px 500px at -10% 110%,#3a1f4d 0%,transparent 60%),var(--bg)}
.scr.on{display:block}
.shell{max-width:980px;margin:0 auto;display:grid;grid-template-columns:minmax(240px,320px) 1fr;gap:18px}
@media(max-width:720px){.shell{grid-template-columns:1fr}}
.logo{font-weight:900;font-size:44px;letter-spacing:.05em;line-height:1;color:var(--acc);text-shadow:0 3px 0 #3a5a00}
.sub{font-size:11px;letter-spacing:.3em;color:var(--mut);margin:4px 0 14px}
.col{display:flex;flex-direction:column;gap:10px;min-width:0}
button{font:inherit;color:var(--fg);background:var(--p2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-weight:700;cursor:pointer;text-align:left;box-shadow:0 3px 0 #0a0e22}
button:active{transform:translateY(2px);box-shadow:0 1px 0 #0a0e22}
button.big{font-size:20px;padding:14px 16px}
button.big small{display:block;font-size:12px;font-weight:600;color:var(--mut);margin-top:2px}
button.p{background:var(--acc);color:#12200a;border-color:#d6ff8a}
button.p small{color:#34521a}
button.o{background:var(--acc2);color:#2a1100;border-color:#ffb27a}
button.o small{color:#5a2a08}
button.d{color:var(--bad)}
button:disabled{opacity:.5}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.card{background:linear-gradient(180deg,var(--p1),#101531);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px;min-width:0}
h3{margin:0;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--mut)}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.row>*{min-width:0}
.mut{color:var(--mut);font-size:13px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:9px 14px;border-radius:999px;box-shadow:none;font-size:14px}
.chip.sel{background:var(--acc);color:#12200a;border-color:#d6ff8a}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.mc{padding:6px;display:flex;flex-direction:column;gap:6px;box-shadow:none;border-radius:12px}
.mc canvas{width:100%;aspect-ratio:16/9;border-radius:8px;display:block;background:#000}
.mc.sel{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc) inset}
input[type=text],select{width:100%;background:#0a0e22;border:1px solid var(--line);color:var(--fg);border-radius:10px;padding:11px;font:inherit;-webkit-user-select:text;user-select:text}
input[type=range]{width:100%;accent-color:var(--acc)}
input[type=checkbox]{width:22px;height:22px;accent-color:var(--acc)}
.top{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.tabs{display:flex;gap:8px;flex-wrap:wrap}
.id{font:800 22px ui-monospace,Menlo,monospace;letter-spacing:.14em;color:var(--acc)}
.fr{display:flex;gap:8px;align-items:center;padding:9px 0;border-top:1px solid var(--line)}
.fr:first-child{border-top:0}
.fr .n{flex:1;min-width:0;overflow-wrap:anywhere}
.fr .s{font-size:12px;color:var(--mut)}
.dot{width:10px;height:10px;border-radius:50%;background:#555;flex:none}
.dot.on{background:var(--ok)}.dot.room{background:var(--acc)}
.sw{display:flex;flex-wrap:wrap;gap:8px}
.sw button{width:38px;height:38px;border-radius:50%;padding:0;box-shadow:none;border:2px solid var(--line)}
.sw button.sel{border-color:#fff;box-shadow:0 0 0 2px var(--acc)}
#st{position:fixed;left:50%;bottom:max(14px,env(safe-area-inset-bottom));transform:translateX(-50%);z-index:30;background:#0a0e22ee;border:1px solid var(--line);padding:9px 16px;border-radius:999px;font-size:14px;display:none;max-width:92vw;text-align:center}
#st.err{border-color:var(--bad);color:#ffb3bb}
canvas#pv,canvas#pv3{border-radius:12px;background:#0a0e22;border:1px solid var(--line)}
canvas#pv{width:160px;height:120px}
canvas#pv3{width:100%;height:260px;touch-action:none}
#ov{position:fixed;inset:0;display:none;align-items:center;justify-content:center;text-align:center;background:rgba(6,8,18,.97);z-index:40;font-size:26px;font-weight:800;padding:24px;color:var(--acc);line-height:1.2}
#x{position:fixed;top:max(6px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);z-index:35;display:none;padding:4px 14px;font-size:12px;opacity:.5;text-align:center}
#err{position:fixed;left:8px;right:8px;top:8px;z-index:99;display:none;background:#400a12;border:1px solid var(--bad);color:#ffd5da;padding:8px 10px;border-radius:10px;font:12px/1.3 ui-monospace,monospace;max-height:40vh;overflow:auto}
.set{display:grid;grid-template-columns:1fr minmax(120px,240px);gap:8px 14px;align-items:center}
@media(max-width:560px){.set{grid-template-columns:1fr}}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:720px){.two{grid-template-columns:1fr}}
</style>
</head>
<body>
<canvas id="c"></canvas>
<button id="x">SAIR</button>
<div id="ov"></div>
<div id="st"></div>
<div id="err"></div>

<section class="scr on" id="s-home"><div class="shell">
  <div class="col">
    <div><div class="logo">LUKZ TAG</div><div class="sub">PIQUE-PEGA EM VR</div></div>
    <button class="big p" id="bPlay">JOGAR<small id="playSub">Clássico · Bosque</small></button>
    <button class="big o" id="bOnline">ONLINE<small>Sala privada, ID e amigos</small></button>
    <button class="big" id="bCustom">PERSONALIZAR<small>Cores e chapéus</small></button>
    <button class="big" id="bSet">AJUSTES<small>Mãos, sensores, lente e desempenho</small></button>
  </div>
  <div class="col">
    <div class="card">
      <div class="row"><div style="flex:1;min-width:0"><div id="pName" style="font-weight:800;font-size:20px;overflow-wrap:anywhere">Jogador</div><div class="mut">Seu ID</div></div><div class="id" id="pId">-----</div><button id="pCopy">Copiar</button></div>
    </div>
    <div class="card"><h3>Modo</h3><div class="chips" id="modes"></div><div class="mut" id="mdesc"></div></div>
    <div class="card"><h3>Mapa</h3><div class="cards" id="maps"></div><div class="mut" id="mapdesc"></div></div>
  </div>
</div></section>

<section class="scr" id="s-online"><div class="shell" style="grid-template-columns:1fr;max-width:640px">
  <div class="top"><button id="bBack1">‹ Voltar</button><div class="tabs"><button class="chip sel" id="tabC">Criar sala</button><button class="chip" id="tabJ">Entrar por ID</button><button class="chip" id="tabF">Amigos</button></div></div>
  <div class="card" id="pC">
    <h3>Sua sala privada</h3>
    <div class="two"><div><div class="mut">Modo</div><select id="oMode"></select></div><div><div class="mut">Mapa</div><select id="oMap"></select></div></div>
    <div class="row"><span class="mut">Seu ID (seus amigos digitam este código):</span><span class="id" id="oId">-----</span></div>
    <button class="big p" id="bCreate">CRIAR SALA<small>Você é o servidor, até 8 jogadores</small></button>
  </div>
  <div class="card" id="pJ" style="display:none">
    <h3>Entrar na sala de um amigo</h3>
    <div class="mut">Digite o ID do amigo. Você entra na sala em que ele está.</div>
    <input id="jId" type="text" maxlength="8" placeholder="ID do amigo" autocapitalize="characters" autocomplete="off">
    <button class="big p" id="bJoin">ENTRAR</button>
  </div>
  <div class="card" id="pF" style="display:none">
    <h3>Amigos</h3>
    <div class="row"><input id="fid" type="text" maxlength="8" placeholder="ID do amigo" autocapitalize="characters" autocomplete="off" style="flex:1"><button id="fadd">Adicionar</button></div>
    <div id="fl"></div>
  </div>
</div></section>

<section class="scr" id="s-custom"><div class="shell" style="max-width:860px;grid-template-columns:1fr 1fr">
  <div class="col" style="grid-column:1/-1"><div class="top"><button id="bBack2">‹ Voltar</button><div class="logo" style="font-size:26px">PERSONALIZAR</div></div></div>
  <div class="col"><canvas id="pv3" width="400" height="300"></canvas><div class="mut">Arraste para girar.</div><input id="cName" type="text" maxlength="12" placeholder="Seu nome" autocomplete="off"></div>
  <div class="col">
    <div class="card"><h3>Cor do pelo</h3><div class="sw" id="furs"></div></div>
    <div class="card"><h3>Cor do rosto</h3><div class="sw" id="faces"></div></div>
    <div class="card"><h3>Chapéu</h3><div class="chips" id="hats"></div></div>
  </div>
</div></section>

<section class="scr" id="s-set"><div class="shell" style="max-width:700px;grid-template-columns:1fr">
  <div class="top"><button id="bBack3">‹ Voltar</button><div class="logo" style="font-size:26px">AJUSTES</div></div>
  <div class="card">
    <h3>Sensores</h3>
    <div class="mut" id="gs">Verificando giroscópio...</div>
    <div class="row"><button id="bSens">Ativar sensores</button></div>
  </div>
  <div class="card">
    <h3>Mãos</h3>
    <div class="set"><label for="useHands">Hand tracking pela câmera de trás</label><input type="checkbox" id="useHands"></div>
    <div class="set"><label for="sens">Sensibilidade ao andar <b id="sensV"></b></label><input type="range" id="sens" min="0.5" max="2" step="0.1"></div>
    <div class="row"><button id="tst">Testar mãos</button><canvas id="pv" width="160" height="120"></canvas></div>
    <div class="mut" id="hs">Mostre as duas mãos para a câmera de trás. Balance os braços para andar na direção em que você olha. Levante as duas mãos juntas e rápido para pular.</div>
  </div>
  <div class="card">
    <h3>Imagem</h3>
    <div class="set"><label for="vr">Modo VR (tela dividida)</label><input type="checkbox" id="vr"></div>
    <div class="set"><label for="lens">Correção da lente <b id="lensV"></b></label><input type="range" id="lens" min="0" max="1.6" step="0.1"></div>
    <div class="set"><label for="fov">Campo de visão <b id="fovV"></b></label><input type="range" id="fov" min="70" max="115" step="1"></div>
    <div class="set"><label for="ipd">Distância entre os olhos <b id="ipdV"></b></label><input type="range" id="ipd" min="0.05" max="0.078" step="0.001"></div>
    <div class="set"><label for="qual">Qualidade</label><select id="qual"><option value="auto">Automática (recomendado)</option><option value="0.5">Baixa</option><option value="0.7">Média</option><option value="1">Alta</option></select></div>
    <div class="set"><label for="sound">Sons</label><input type="checkbox" id="sound"></div>
  </div>
</div></section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
