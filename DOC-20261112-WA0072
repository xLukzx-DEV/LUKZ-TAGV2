  rules.names[me.id]=myName();
  for(const p of hostPlayers.values()){pl.push({id:p.id,h:p.h,l:p.l,r:p.r});rules.names[p.id]=p.n}
  rules.tick(dt,pl);
  const ps=[[me.id,rules.role(me.id),f9(sp),f2(selfV.yaw),f2(selfV.pitch)]];
  for(const p of hostPlayers.values())ps.push([p.id,rules.role(p.id),f9([...p.h,...p.l,...p.r]),f2(p.yaw),f2(p.pitch)]);
