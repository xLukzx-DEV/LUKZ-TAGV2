async function goPublic(){
  if(busy)return;busy=true;lock(true);
  try{
    if(!await prepare())return;
    setSt('Procurando sala '+MODES.find(m=>m.id===cfg.mode).name+' · '+MAPDEF[cfg.map].name+'...');
    for(let i=1;i<=3;i++){
      const pid='lt-p'+cfg.mode+cfg.map+'-'+i,j=await joinRoom(pid);
      if(j.r==='ok'){return await enter(j.mode,j.map,'Pública '+i)}
